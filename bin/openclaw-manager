#!/usr/bin/env bash
# Backward-compatible entry point for v1 users.
set -euo pipefail

echo "openclaw-manager has moved to OpenClaw Companion / OpenClaw 中文助手." >&2
if command -v openclaw-companion >/dev/null 2>&1; then
  exec openclaw-companion menu "$@"
fi
if ! command -v npx >/dev/null 2>&1; then
  echo "Run install.sh first or install openclaw-companion from npm." >&2
  exit 1
fi
exec npx -y openclaw-companion@latest menu "$@"
